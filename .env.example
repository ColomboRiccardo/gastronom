# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Site ---
# Every link inside an outgoing email is built from this. If it is missing in
# production, customers receive emails pointing at http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend ---
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, otherwise deliverability
# suffers and customer replies go nowhere.
RESEND_FROM_EMAIL=ordini@gastronom.it
RESEND_FROM_NAME=Gastronom
# Where customer replies should land.
RESEND_REPLY_TO=gastronom.sanremo@gmail.com
# Who gets the internal recap when a new order comes in.
ORDER_ALERT_EMAIL=gastronom.sanremo@gmail.com
